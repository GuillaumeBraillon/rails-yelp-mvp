<div class="container mt-4 w-50">
  <h1 class="mb-4">Yelp</h1>
  <ul class="list-group">
    <% @restaurants.each do |restaurant| %>
      <li class="list-group-item d-flex justify-content-between align-items-center">    <%= link_to restaurant.name, restaurant_path(restaurant) %></li>
    <% end %>
  </ul>
  <p><%= link_to "Add a new Restaurant", new_restaurant_path %></p>
</div>

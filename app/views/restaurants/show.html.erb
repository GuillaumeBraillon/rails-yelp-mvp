<div class="container mt-4 w-50">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0"><%= @restaurant.name %></h1>
    <h2 class="mb-0"><%= @restaurant.category.capitalize() %></h2>
  </div>
  <div class="mb-4">
    <p class="mb-4 alert alert-info">Address : <%= @restaurant.address %></p>
    <p class="mb-4">Phone number : <%= @restaurant.phone_number %></p>
  </div>
  <p><strong>Reviews</strong></p>
  <ul class="list-group">
    <% @restaurant.reviews.each do |review| %>
      <li class="list-group-item"><strong><%= review.content %></strong> (<%= review.rating%> / 5) </li>
    <% end %>
  </ul>
  <br>
  <h2 class="mb-0">New review</h2>
  <%= render "form_review", review: @review, restaurant: @restaurant %>
  <% if @restaurant.errors.any? %>
    <ul>
      <% @restaurant.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>
  <% if @review.errors.any? %>
    <ul>
      <% @review.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>
  <p class="mb-4"><%= link_to "Back to list", restaurants_path %></p>
</div>
  <%= simple_form_for [restaurant, review] do |f| %>
  <div class="mb-4">
    <p class="mb-4">
      <%= f.input :content %>
    </p>
    <p class="mb-4">
      <%= f.select :rating,
        [0, 1, 2, 3, 4, 5],
        { prompt: "Rate it" },
        { class: "form-select" } %>
    </p>
    <p class="mb-4">
      <%= f.submit "Submit review", class: "btn btn-primary" %>
    </p>
  </div>
<% end %>